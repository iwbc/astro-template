{
  "mcpServers": {
    "astro-docs": {
      "type": "http",
      "url": "https://mcp.docs.astro.build/mcp"
    },
    "playwright-chrome": {
      "command": "pnpm",
      "args": [
        "dlx",
        "@playwright/mcp@latest",
        "--browser",
        "chrome",
        "--isolated",
        "--output-dir",
        ".claude/tmp/playwright-chrome"
      ]
    }
  }
}
